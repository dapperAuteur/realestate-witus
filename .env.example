# RealEstate.WitUS.Online environment. Copy to .env.local and fill in.
# Names mirror src/lib/env.ts, which is the single source of truth.
# Never commit a filled-in copy: .env and .env.* are gitignored.
#
# An EMPTY key is treated as unset everywhere (`Boolean("")` is false), so a
# declared-but-blank BETTER_AUTH_SECRET breaks sign-in exactly like a missing
# one. Fill a key or leave the whole line out.

# ── Database (Neon) ──────────────────────────────────────────────────────────
# The Vercel Neon Marketplace integration injects STORAGE_DATABASE_URL.
# Plain DATABASE_URL is the local / manually provisioned fallback.
DATABASE_URL=

# ── Auth (Better Auth, magic link only) ──────────────────────────────────────
# BETTER_AUTH_SECRET: a long random string. BETTER_AUTH_URL: the deployment
# origin, e.g. https://realestate.witus.online (http://localhost:3000 locally).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# ── Email (Mailgun) ──────────────────────────────────────────────────────────
# Without these the mailer logs to the console, so magic links still work in
# local dev. MAILGUN_REGION is "us" or "eu".
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
MAIL_FROM=

# ── Platform billing (customer pays BAM) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_MOMO_NUMBER=
PLATFORM_MOMO_NAME=

# ── Media (Cloudinary signed uploads) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Domain manager (Vercel API, used by /platform/domains) ───────────────────
VERCEL_DOMAINS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── WitUS ecosystem webhooks (optional, HMAC-signed, best effort) ────────────
WITUS_INBOX_URL=
WITUS_INBOX_HMAC_SECRET=
OUTBOX_URL=
OUTBOX_HMAC_SECRET=
# Keep false until the outbox is tested end to end.
OUTBOX_TRIGGER_ENABLED=false

# ── Error monitoring (Better Stack, Sentry-compatible ingest) ────────────────
# Leave every line blank to keep monitoring off: with no DSN the SDK never
# initializes on any runtime, so nothing is sent and nothing changes.
# SENTRY_DSN is the server + edge source DSN, NEXT_PUBLIC_SENTRY_DSN the
# browser one (safe to expose; it only accepts writes). SENTRY_ENVIRONMENT
# labels the events and defaults to VERCEL_ENV, then NODE_ENV.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Build-time only, for uploading source maps so stack traces are readable.
# Without SENTRY_AUTH_TOKEN the upload step is skipped and the build still
# succeeds. SENTRY_ORG / SENTRY_PROJECT come from the Better Stack source.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Demo logins (demo.realestate.witus.online) ───────────────────────────────
# All four must be non-empty or the demo buttons and ribbon stay hidden and
# /api/demo-login returns 503. The passwords are read server-side only and are
# re-hashed on every seed, so changing one here rotates that login.
# The owner demo sees everything; the visitor demo is an agent (no design,
# team, or billing). Unprefixed: only the Neon vars carry STORAGE_.
DEMO_ADMIN_USER_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_VISITOR_USER_EMAIL=
DEMO_VISITOR_PASSWORD=

# ── Operations ───────────────────────────────────────────────────────────────
# CRON_SECRET also guards the nightly demo reset; the cron 401s without it.
CRON_SECRET=
ADMIN_NOTIFY_EMAIL=
# Opens the one-time platform-owner bootstrap window. Set back to false after
# the first owner exists.
PLATFORM_BOOTSTRAP=false
